# =============================================
# SmartDoc Tutor — Backend Environment Variables
# Copy this file to .env and fill in your values
# =============================================

# Groq API Key (required — get one at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL connection URL
# Local:   postgresql+asyncpg://postgres:postgres@localhost:5432/smartdoc_tutor
# Neon:    postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?ssl=require
# Supabase: postgresql+asyncpg://postgres:password@db.xxx.supabase.co:5432/postgres
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartdoc_tutor

# JWT secret key — CHANGE THIS in production!
# Generate one with: openssl rand -hex 32
SECRET_KEY=supersecretkey_for_development_only_change_in_production

# Comma-separated list of allowed frontend origins (no trailing slashes)
# Local dev default is already set in code, only set this in production
# Example: ALLOWED_ORIGINS=https://smartdoc-tutor.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
